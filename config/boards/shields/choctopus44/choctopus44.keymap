#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE_WIN 0
#define BASE_MAC 1
#define LOWER 2
#define RAISE_WIN 3
#define RAISE_MAC 4
#define ADJUST 5

&mt {
    tapping-term-ms = <400>;
};

/ {
  keymap {
    compatible = "zmk,keymap";


    default_layer {
      bindings = <
        &kp TAB     &kp Q     &kp W       &kp E     &kp R    &kp T                &kp Y     &kp U     &kp I      &kp O    &kp P     &kp LBKT
        &mt LCTRL ESC     &mt LGUI A     &mt LALT S  &mt LCTRL D  &mt LSHIFT F    &kp G                &kp H     &mt LSHFT J     &mt LCTRL K  &mt LALT L  &mt LGUI SEMI  &kp SQT
        &kp LSHFT   &kp Z     &kp X       &kp C     &kp V    &kp B      &kp RET   &kp N     &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH
                              &kp LALT   &mo LOWER  &kp BSPC    &kp RET               &kp DEL  &kp SPACE   &lt RAISE_WIN RGUI   &kp RALT
      >;
      sensor-bindings = <&inc_dec_kp UP DOWN>;
    };

    mac_default_layer {
      bindings = <
        &kp TAB     &kp Q     &kp W       &kp E     &kp R    &kp T                &kp Y     &kp U     &kp I      &kp O    &kp P     &kp LBKT
        &mt LGUI ESC     &mt LCTRL A     &mt LALT S  &mt LGUI D  &mt LSHIFT F    &kp G                &kp H     &mt LSHFT J     &mt LGUI K  &mt LALT L  &mt LCTRL SEMI  &kp SQT
        &kp LSHFT   &kp Z     &kp X       &kp C     &kp V    &kp B      &kp RET   &kp N     &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp BSLH
                              &kp LALT   &mo LOWER  &kp BSPC    &kp RET               &kp DEL  &kp SPACE   &lt RAISE_MAC RGUI   &kp RALT
      >;
      sensor-bindings = <&inc_dec_kp UP DOWN>;
    };

    lower_layer {
      bindings = <
        &trans    &kp N1    &kp N2  &kp N3   &kp N4   &kp N5                          &kp N6              &kp N7            &kp N8      &kp N9      &kp N0    &kp MINUS
        &kp TILDE &kp EXCL  &kp AT  &kp HASH &kp DLLR &kp PRCNT                       &kp CARET           &kp AMPS          &kp STAR    &kp LPAR    &kp RPAR  &kp EQUAL
        &kp PIPE  &kp BSLH    &trans  &trans   &trans   &kp CAPS    &kp C_PLAY_PAUSE  &kp LS(NON_US_HASH) &kp NON_US_HASH   &kp EQUAL   &kp GRAVE   &trans    &trans
                            &trans  &trans   &trans   &trans                          &trans              &mo ADJUST        &trans      &bootloader
      >;
      sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
    };

    raise_layer {
      bindings = <
        &trans      &kp F1            &kp F2                &kp F3                &kp F4      &kp LS(N9)                &kp LS(FSLH)          &kp FSLH          &kp LC(LEFT)      &kp UP    &kp LC(RIGHT)    &kp RA(RBKT)
        &kp GRAVE   &kp F5            &kp F6                &kp F7                &kp F8      &kp EQUAL                 &kp RA(MINUS)         &kp LEFT          &kp LEFT    &kp DOWN   &kp RIGHT   &kp RA(N4)
        &trans      &kp F9            &kp F10               &kp F11               &kp F12     &kp RA(N0)   &kp C_MUTE   &kp LS(NON_US_HASH)   &kp NON_US_HASH   &kp LS(N5)  &kp LS(N6)  &kp LS(N7)      &trans
                                      &trans                &trans                &mo ADJUST  &trans                    &trans                &trans            &trans      &trans
      >;
      sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
    };

    mac_raise_layer {
      bindings = <
        &trans      &kp F1            &kp F2                &kp F3                &kp F4      &kp LS(N9)                &kp LS(FSLH)          &kp FSLH          &kp LA(LEFT)      &kp UP    &kp LA(RIGHT)    &kp RA(RBKT)
        &kp GRAVE   &kp F5            &kp F6                &kp F7                &kp F8      &kp EQUAL                 &kp RA(MINUS)         &kp LEFT          &kp LEFT    &kp DOWN   &kp RIGHT   &kp RA(N4)
        &trans      &kp F9            &kp F10               &kp F11               &kp F12     &kp RA(N0)   &kp C_MUTE   &kp LS(NON_US_HASH)   &kp NON_US_HASH   &kp LS(N5)  &kp LS(N6)  &kp LS(N7)      &trans
                                      &trans                &trans                &mo ADJUST  &trans                    &trans                &trans            &trans      &trans
      >;
      sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
    };

    adjust_layer {
      bindings = <
        &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &bt BT_CLR                &none         &none         &kp PSCRN     &kp SLCK    &kp PAUSE_BREAK   &none
        &none         &none           &none           &none           &none           &none                     &to BASE_WIN  &to BASE_MAC  &kp INSERT    &kp HOME    &kp PG_UP         &none
        &none         &none           &none           &none           &none           &none       &kp C_MUTE    &bootloader   &kp C_RESET   &kp DEL       &kp END     &kp PG_DN         &none
                                      &trans          &trans          &trans          &trans                    &trans        &trans        &trans        &trans
      >;
      sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
    };

  };
};
